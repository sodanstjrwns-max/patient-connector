{
  "name": "patient-connect",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy --project-name patient-connect",
    "typecheck": "tsc --noEmit",
    "test:categories": "node tests/material-categories.mjs",
    "test:library": "node tests/material-library.mjs",
    "test:media": "node tests/material-media.mjs",
    "mockups:render": "node scripts/render-media-mockups.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "wrangler": "^4.86.0"
  }
}
